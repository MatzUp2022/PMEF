{
  "$schema": "https://pmef.net/schemas/0.9/pmef-catalog.schema.json",
  "catalogId": "pipe-supports-generic",
  "catalogType": "PIPE_SUPPORT_TYPES",
  "version": "2026.1",
  "description": "Generic pipe support assemblies for preliminary design and auto-routing. A pmef:PipeSupport references an entry via catalogRef {catalogId: 'pipe-supports-generic', standard: <supportCode>}.",
  "units": {
    "dnMin": "DN",
    "dnMax": "DN",
    "shoeHeight_mm": "mm",
    "travel_mm": "mm"
  },
  "fieldDefinitions": {
    "restraints": "Restrained degrees of freedom in pipe coordinates: AXIAL along the pipe, LATERAL horizontal across it, VERTICAL_DOWN/UP, ROTATION about the pipe axes.",
    "shoeHeight_mm": "Distance from the top of the support steel to the bottom of the pipe."
  },
  "notes": [
    "Synthetic, vendor-neutral catalog. Load ratings are deliberately not given: they depend on the manufacturer and the support steel.",
    "Designs must be verified by pipe stress analysis."
  ],
