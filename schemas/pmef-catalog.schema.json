{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pmef.net/schemas/0.9/pmef-catalog.schema.json",
  "title": "PMEF Catalog",
  "description": "Schema for PMEF open catalog files (steel profiles, piping classes, pipe/flange/duct dimensions, materials, instruments, pipe support types, cable types, and reference-data mappings). The shape of each 'entries' item is constrained by 'catalogType'.",
  "type": "object",
  "required": [
    "catalogId",
    "catalogType",
    "version",
    "description",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional JSON Schema reference for editor tooling."
    },
    "catalogId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique catalog identifier, e.g. 'profiles-en'."
    },
    "catalogType": {
      "type": "string",
      "enum": [
        "STEEL_PROFILES",
        "PIPING_CLASS",
        "PIPE_DIMENSIONS",
        "FLANGE_DIMENSIONS",
        "INSTRUMENT_CATALOG",
        "MATERIAL_GRADES",
        "RDL_MAPPING",
        "PIPE_STRESS_MAPPING",
        "DUCT_DIMENSIONS",
        "PIPE_SUPPORT_TYPES",
        "CABLE_TYPES",
        "NATIVE_TYPE_MAPPING"
      ],
      "description": "Catalog domain type. Determines the required fields of each entry."
    },
    "standard": {
      "type": "string",
      "description": "Governing standard or code, e.g. 'EN 10025-2' or 'ASME B36.10'."
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "description": "Catalog version string."
    },
    "description": {
      "type": "string",
      "description": "Human-readable summary of the catalog contents."
    },
    "units": {
      "type": "object",
      "description": "Map of field name to unit symbol used across entries.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fieldDefinitions": {
      "type": "object",
      "description": "Meaning of the entry fields of this catalog (field name -> definition), e.g. which thickness convention a flange catalog uses.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "families": {
      "type": "object",
      "description": "Map of family code to human-readable family name.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "note": {
      "type": "string",
      "description": "Single free-form note about the catalog."
    },
    "notes": {
      "type": "array",
      "description": "List of free-form notes about the catalog.",
      "items": {
        "type": "string"
      }
    },
    "entries": {
      "type": "array",
      "description": "Catalog entries. Item shape is refined by 'catalogType'.",
      "items": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "catalogType": { "const": "STEEL_PROFILES" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/steelProfileEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "PIPING_CLASS" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/pipingClassEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "PIPE_DIMENSIONS" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/pipeDimensionEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "FLANGE_DIMENSIONS" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/flangeDimensionEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "INSTRUMENT_CATALOG" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/instrumentEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "MATERIAL_GRADES" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/materialGradeEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "RDL_MAPPING" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/rdlMappingEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "PIPE_STRESS_MAPPING" } }
      },
      "then": {
        "required": ["mappings"],
        "properties": {
          "mappings": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/pipeStressMappingEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "DUCT_DIMENSIONS" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/ductDimensionEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "PIPE_SUPPORT_TYPES" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/pipeSupportTypeEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "CABLE_TYPES" } }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/cableTypeEntry" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "catalogType": { "const": "NATIVE_TYPE_MAPPING" } }
      },
      "then": {
        "required": ["sourceSystem"],
        "properties": {
          "sourceSystem": { "type": "string", "minLength": 1, "description": "Authoring tool, same value as HasEquivalentIn.targetSystem, e.g. 'AVEVA_E3D'." },
          "entries": {
            "minItems": 1,
            "items": { "$ref": "#/$defs/nativeTypeEntry" }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "catalogRef": {
      "type": "string",
      "minLength": 1,
      "title": "Catalog Entry Identifier",
      "description": "Stable identifier for the entry, unique within the catalog."
    },
    "steelProfileEntry": {
      "type": "object",
      "title": "Steel Profile Entry",
      "description": "A single hot-rolled or built-up steel profile.",
      "required": ["catalogId", "family"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "family": {
          "type": "string",
          "title": "Profile Family",
          "description": "Section family code, e.g. 'HEA', 'IPE', 'W', 'L'."
        }
      }
    },
    "pipingClassEntry": {
      "type": "object",
      "title": "Piping Class Entry",
      "description": "A single component selection within a piping class.",
      "required": ["catalogId", "componentClass", "skey", "standard"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "componentClass": {
          "type": "string",
          "title": "Component Class",
          "description": "Component class, e.g. 'PIPE', 'ELBOW', 'FLANGE', 'VALVE'."
        },
        "skey": {
          "type": "string",
          "title": "Symbol Key",
          "description": "PCF/ISOGEN SKEY identifying the component symbol."
        },
        "standard": {
          "type": "string",
          "title": "Standard",
          "description": "Dimensional/material standard for the component."
        }
      }
    },
    "pipeDimensionEntry": {
      "type": "object",
      "title": "Pipe Dimension Entry",
      "description": "A nominal pipe size with its outside diameter and wall data.",
      "required": ["catalogId", "DN", "OD_mm"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "DN": {
          "type": "number",
          "title": "Nominal Diameter",
          "description": "Nominal diameter (DN)."
        },
        "OD_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "title": "Outside Diameter",
          "description": "Outside diameter in millimetres."
        }
      }
    },
    "flangeDimensionEntry": {
      "type": "object",
      "title": "Flange Dimension Entry",
      "description": "A single flange dimension row for a size/rating pair.",
      "required": ["catalogId", "nominalDiameter", "pressureClass", "flangeOD_mm"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "nominalDiameter": {
          "type": "number",
          "title": "Nominal Diameter",
          "description": "Nominal diameter (DN)."
        },
        "pressureClass": {
          "type": ["number", "string"],
          "title": "Pressure Class",
          "description": "Flange pressure class: numeric ASME class (150, 300, 600) or EN nominal pressure string ('PN10', 'PN16')."
        },
        "flangeOD_mm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "title": "Flange Outside Diameter",
          "description": "Flange outside diameter in millimetres."
        },
        "NPS": { "type": "number", "exclusiveMinimum": 0, "description": "Nominal pipe size [in] (ASME)." },
        "DN": { "type": "integer", "exclusiveMinimum": 0, "description": "Nominal diameter DN (EN)." },
        "flangeThickness_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Flange thickness [mm]; convention per the catalog's fieldDefinitions (ASME B16.5: tf without raised face; EN 1092-1: C1)." },
        "boltCircle_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Bolt circle diameter [mm]." },
        "boltHoles": { "type": "integer", "minimum": 4, "multipleOf": 4, "description": "Number of bolt holes." },
        "boltDiameter_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Nominal bolt (stud) diameter [mm] (M12 -> 12; 1/2 in -> 12.7)." },
        "boltHoleDiameter_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Bolt hole diameter [mm]." },
        "raisedFace_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Raised face diameter [mm]." },
        "facingType": { "type": "string", "enum": ["RF", "FF", "RTJ"], "description": "Facing: raised face, flat face, ring-type joint." }
      }
    },
    "instrumentEntry": {
      "type": "object",
      "title": "Instrument Entry",
      "description": "A single field instrument type in the instrument catalog.",
      "required": ["catalogId", "instrumentType", "measuredVariable"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "instrumentType": {
          "type": "string",
          "title": "Instrument Type",
          "description": "Instrument type, e.g. 'TRANSMITTER', 'GAUGE', 'SWITCH'."
        },
        "measuredVariable": {
          "type": "string",
          "title": "Measured Variable",
          "description": "Measured variable, e.g. 'TEMPERATURE', 'PRESSURE', 'FLOW'."
        }
      }
    },
    "materialGradeEntry": {
      "type": "object",
      "title": "Material Grade Entry",
      "description": "A single material grade with mechanical properties.",
      "required": ["catalogId", "designation", "standard", "family"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "designation": {
          "type": "string",
          "title": "Designation",
          "description": "Material designation, e.g. 'S235JR', 'A36'."
        },
        "standard": {
          "type": "string",
          "title": "Standard",
          "description": "Material standard, e.g. 'EN 10025-2', 'ASTM A36/A36M'."
        },
        "family": {
          "type": "string",
          "title": "Material Family",
          "description": "Material family/grouping code."
        }
      }
    },
    "rdlMappingEntry": {
      "type": "object",
      "title": "RDL Mapping Entry",
      "description": "A mapping from a PMEF type to a reference-data-library URI.",
      "required": ["pmefType", "rdlUri", "label"],
      "properties": {
        "pmefType": {
          "type": "string",
          "title": "PMEF Type",
          "description": "PMEF type token, e.g. 'pmef:Pump'."
        },
        "equipmentClass": {
          "type": "string",
          "title": "Equipment Class",
          "description": "Optional equipment sub-class modifier, e.g. 'CENTRIFUGAL_PUMP'."
        },
        "componentClass": {
          "type": "string",
          "title": "Component Class",
          "description": "Optional piping component sub-class modifier, e.g. 'ELBOW'."
        },
        "instrumentClass": {
          "type": "string",
          "title": "Instrument Class",
          "description": "Optional instrument sub-class modifier."
        },
        "rdlUri": {
          "type": "string",
          "format": "uri",
          "title": "RDL URI",
          "description": "Reference-data-library URI (e.g. POSC Caesar RDL)."
        },
        "label": {
          "type": "string",
          "title": "Label",
          "description": "Human-readable label for the mapped concept."
        }
      }
    },
    "pipeStressMappingEntry": {
      "type": "object",
      "title": "Pipe Stress Mapping Entry",
      "description": "A single field mapping between a pipe-stress interchange format (e.g. CAESAR II .cii) and a PMEF path. Carried in the top-level 'mappings' array; 'entries' is unused for this catalog type.",
      "required": ["section", "ciiField", "ciiRecord", "direction", "pmefPath"],
      "properties": {
        "section": {
          "type": "string",
          "title": "Section",
          "description": "Logical section of the source format the field belongs to."
        },
        "ciiField": {
          "type": "string",
          "title": "Source Field",
          "description": "Field name in the pipe-stress format (e.g. CAESAR II .cii field)."
        },
        "ciiRecord": {
          "type": "string",
          "title": "Source Record",
          "description": "Record/table in the pipe-stress format that holds the field."
        },
        "direction": {
          "type": "string",
          "enum": ["import", "export", "bidirectional"],
          "title": "Mapping Direction",
          "description": "Direction in which the mapping applies."
        },
        "pmefPath": {
          "type": "string",
          "title": "PMEF Path",
          "description": "Target path within the PMEF model for the mapped value."
        }
      }
    },
    "ductDimensionEntry": {
      "type": "object",
      "title": "Duct Dimension Entry",
      "description": "A standard air-duct size: a round nominal diameter (EN 1506) or a rectangular side length (EN 1505).",
      "required": ["series", "size_mm"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "series": { "type": "string", "enum": ["ROUND", "RECTANGULAR"], "description": "ROUND: size_mm is the nominal diameter; RECTANGULAR: size_mm is a preferred side length (width or height)." },
        "size_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Nominal diameter or side length [mm]." },
        "area_m2": { "type": "number", "exclusiveMinimum": 0, "description": "Inside cross-section area [m²] (ROUND: π·d²/4)." }
      },
      "additionalProperties": false
    },
    "pipeSupportTypeEntry": {
      "type": "object",
      "title": "Pipe Support Type Entry",
      "description": "A standard pipe support assembly that a PipeSupport references via catalogRef (catalogId = this catalog, standard = supportCode).",
      "required": ["supportCode", "supportType", "dnMin", "dnMax", "restraints"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "supportCode": { "type": "string", "minLength": 1, "description": "Catalog code of the assembly, e.g. 'RS-SHOE'." },
        "supportType": {
          "type": "string",
          "enum": ["ANCHOR", "GUIDE", "DIRECTIONAL", "SPRING_VARIABLE", "SPRING_CONSTANT", "HANGER", "RESTING", "TRUNNION", "CLAMP", "STRAP", "SADDLE", "DUMMY_LEG", "SLIDE_PLATE"],
          "description": "Same values as SupportSpec.supportType."
        },
        "description": { "type": "string" },
        "dnMin": { "type": "integer", "minimum": 1, "description": "Smallest nominal diameter DN the assembly fits." },
        "dnMax": { "type": "integer", "minimum": 1, "description": "Largest nominal diameter DN the assembly fits." },
        "restraints": {
          "type": "array",
          "description": "Degrees of freedom the support restrains, in pipe coordinates (axial = along the pipe).",
          "items": { "type": "string", "enum": ["AXIAL", "LATERAL", "VERTICAL_DOWN", "VERTICAL_UP", "ROTATION"] },
          "uniqueItems": true
        },
        "insulatedPipe": { "type": "boolean", "description": "Assembly raises the pipe above its insulation (shoe/saddle height)." },
        "shoeHeight_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Height from support steel to pipe bottom [mm]." },
        "maxLoad_N": { "type": "number", "exclusiveMinimum": 0, "description": "Indicative maximum vertical load [N]." },
        "travel_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Working travel of spring supports [mm]." },
        "material": { "type": "string" }
      },
      "additionalProperties": false
    },
    "cableTypeEntry": {
      "type": "object",
      "title": "Cable Type Entry",
      "description": "A cable type (designation + cores x cross-section) that a CableObject references via catalogRef.",
      "required": ["designation", "cableType", "numberOfCores", "crossSection_mm2"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "designation": { "type": "string", "minLength": 1, "description": "Full designation, e.g. 'NYY-J 3x2.5'." },
        "cableType": {
          "type": "string",
          "enum": ["SIGNAL_ANALOG", "SIGNAL_DISCRETE", "POWER_LV", "POWER_MV", "INSTRUMENTATION_PAIR", "MULTIPAIR", "MULTICORE", "PROFIBUS_PA", "PROFIBUS_DP", "PROFINET", "FIELDBUS_FF", "HART", "FIBER_OPTIC", "COAXIAL", "EARTHING", "CONTROL_SHIELDED"],
          "description": "Same values as CableObject.cableType."
        },
        "numberOfCores": { "type": "integer", "minimum": 1 },
        "numberOfPairs": { "type": "integer", "minimum": 0 },
        "crossSection_mm2": { "type": "number", "exclusiveMinimum": 0, "description": "Conductor cross-section [mm²]." },
        "conductor": { "type": "string", "enum": ["CU", "AL"], "description": "Conductor material." },
        "insulation": { "type": "string", "description": "Core insulation, e.g. 'PVC', 'XLPE', 'EPR'." },
        "sheath": { "type": "string", "description": "Outer sheath, e.g. 'PVC', 'LSZH', 'PCP'." },
        "screenType": { "type": "string", "enum": ["UNSCREENED", "INDIVIDUALLY_SCREENED", "OVERALL_SCREENED", "DOUBLE_SCREENED"] },
        "armoured": { "type": "boolean" },
        "ratedVoltage": { "type": "string", "description": "Rated voltage U0/U, e.g. '0.6/1 kV', '300/500 V'." },
        "outerDiameter_mm": { "type": "number", "exclusiveMinimum": 0, "description": "Typical outer diameter [mm]; manufacturer data governs." },
        "minBendRadiusFactor": { "type": "number", "exclusiveMinimum": 0, "description": "Minimum bending radius as a multiple of the outer diameter (fixed installation)." },
        "standard": { "type": "string", "description": "Product standard, e.g. 'VDE 0276-603'." }
      },
      "additionalProperties": false
    },
    "nativeTypeEntry": {
      "type": "object",
      "title": "Native Type Mapping Entry",
      "description": "Maps an authoring-tool element type (optionally refined by its SKEY) to a PMEF @type and componentClass. The first entry whose conditions hold wins.",
      "required": ["catalogId", "nativeType", "pmefType"],
      "properties": {
        "catalogId": { "$ref": "#/$defs/catalogRef" },
        "nativeType": { "type": "string", "minLength": 1, "description": "Element type keyword in the source tool, e.g. 'VALV', 'PCOM'." },
        "skeyPrefix": { "type": "string", "minLength": 1, "description": "Condition: the SKEY starts with this text (case-insensitive)." },
        "skeyContains": { "type": "string", "minLength": 1, "description": "Condition: the SKEY contains this text (case-insensitive)." },
        "pmefType": { "type": "string", "pattern": "^pmef:[A-Z][A-Za-z]+$", "description": "PMEF @type, e.g. 'pmef:Valve'." },
        "componentClass": { "type": "string", "description": "PipingComponentSpec.componentClass value (pmef-property-sets)." },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
